# Ignore all user-created files inside project workspaces, preserve folder structure
projects/*/*
!projects/*/.gitkeep

# Plugin workspace paths (if projects live under plugins/railbot/projects)
plugins/railbot/projects/*/*
!plugins/railbot/projects/*/.gitkeep

# Python execution caches
__pycache__/
*.pyc
*.pyo

# Temporary ACP artifacts
**/acp:*
acp:*
ta_probe.txt
plugins/mcp/*.db
