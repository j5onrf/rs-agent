/target
target/
.env
*.tmp*
.active_sessions
*.db
*.db-wal
*.db-shm
rustfmt.toml

# RailBot runtime data, sessions, scratchpads, and transcripts
**/.rs/
.rs/
.rs/scratchpad.log
state.json
config.json
