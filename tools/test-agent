    # --- PASS 2: ADAPTER & JSON SELF-HEALING ENGINE ---
    print(f"\n{CYAN}[Pass 2/10] Small-Model Fallback Adapters & Self-Healing JSON{RESET}")
    
    def simulate_normalize(params: dict) -> dict:
        m = dict(params)
        if "path" not in m:
            for alt in ["file", "filename", "filepath", "target", "file_path"]:
                if alt in m:
                    m["path"] = m.pop(alt)
                    break
        if "command" not in m:
            for alt in ["cmd", "exec", "shell_command", "bash", "script"]:
                if alt in m:
                    m["command"] = m.pop(alt)
                    break
        if "pattern" not in m:
            for alt in ["query", "regex", "search_term", "match"]:
                if alt in m:
                    m["pattern"] = m.pop(alt)
                    break
        return m

    normed = simulate_normalize({"filepath": "src/main.rs", "cmd": "cargo check", "query": "fn main"})
    p2_a = normed.get("path") == "src/main.rs" and normed.get("command") == "cargo check" and normed.get("pattern") == "fn main"
    print_result("Parameter Alias Normalization", p2_a, "filepath->path, cmd->command, query->pattern")

    def simulate_heal_json(raw: str) -> dict:
        clean = raw.strip()
        stack = []
        in_str = False
        esc = False
        healed = []
        for ch in clean:
            if in_str:
                if esc: esc = False
                elif ch == "\\": esc = True
                elif ch == '"': in_str = False
            else:
                if ch == '"': in_str = True
                elif ch in '{[': stack.append('}' if ch == '{' else ']')
                elif ch in '}]':
                    if stack and stack[-1] == ch: stack.pop()
            healed.append(ch)
        if in_str: healed.append('"')
        while stack: healed.append(stack.pop())
        try:
            return json.loads("".join(healed))
        except Exception:
            return {}

    healed = simulate_heal_json('{"path": "config.json", "items": [1, 2')
    p2_b = healed.get("path") == "config.json" and len(healed.get("items", [])) == 2
    print_result("Stack-Based Broken JSON Arguments Repair", p2_b, "Repaired unclosed brackets & braces")

    all_passed = all_passed and p2_a and p2_b

