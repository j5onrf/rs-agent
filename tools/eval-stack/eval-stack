def parse_profile_frontmatter(prof_name: str) -> dict[str, Any]:
    prof_file = os.path.join(CFG_DIR, "profiles", f"{prof_name}.md")
    meta = {
        "reasoning_budget": None,
        "adapters": True,
        "purebash": False,
        "delegate": False,
    }
    if os.path.isfile(prof_file):
        content = _safe_read(prof_file)
        if content.startswith("---"):
            parts = content.split("---", 2)
            if len(parts) >= 3:
                for line in parts[1].splitlines():
                    s = line.strip()
                    if s.startswith("reasoning_budget:"):
                        val = s.split(":", 1)[1].strip()
                        if val.isdigit():
                            meta["reasoning_budget"] = int(val)
                    elif s.startswith("adapters:"):
                        meta["adapters"] = "true" in s.lower()
                    elif s.startswith("purebash:"):
                        meta["purebash"] = "true" in s.lower()
                    elif s.startswith("delegate:"):
                        meta["delegate"] = "true" in s.lower()
    return meta


def list_available_profiles() -> list[str]:
    prof_dir = os.path.join(CFG_DIR, "profiles")
    found = []
    if os.path.isdir(prof_dir):
        for entry in sorted(os.listdir(prof_dir)):
            full = os.path.join(prof_dir, entry)
            if os.path.isdir(full) and not entry.startswith("."):
                for sub in sorted(os.listdir(full)):
                    if sub.endswith(".md"):
                        found.append(f"{entry}/{sub[:-3]}")
            elif entry.endswith(".md") and entry != "chat.md":
                found.append(entry[:-3])
    found.sort(key=lambda x: (1 if "/" in x else 0, x))
    return found


def resolve_cli_profile(query: str, profiles: list[str]) -> str | None:
    q = query.strip().lower()
    for p in profiles:
        if p.lower() == q:
            return p
    matches = [p for p in profiles if p.lower().endswith(f"/{q}")]
    if matches:
        return matches[0]
    matches = [p for p in profiles if p.lower().startswith(f"{q}/")]
    if matches:
        self_match = [p for p in matches if p.lower() == f"{q}/{q}"]
        return self_match[0] if self_match else matches[0]
    matches = [p for p in profiles if q in p.lower()]
    return matches[0] if matches else None


def detect_default_profile(model_name: str, profiles: list[str]) -> str:
    m_clean = re.sub(r"[^a-zA-Z0-9]", "", model_name.lower())
    tokens = [t for t in re.split(r"[-_\s\.]+", model_name.lower()) if len(t) >= 3 and not t.isdigit()]

    best_score = -1
    best_prof = profiles[0] if profiles else "chat"

    for p in profiles:
        score = 0
        p_parts = p.lower().split("/")
        folder = p_parts[0] if len(p_parts) > 1 else ""
        stem = p_parts[-1]

        if stem in model_name.lower():
            score += 10
        if folder and folder in model_name.lower():
            score += 8
        if p.lower().replace("/", "") in m_clean:
            score += 15
        for t in tokens:
            if t in stem:
                score += 5
            if folder and t in folder:
                score += 4

        if score > best_score:
            best_score = score
            best_prof = p

    return best_prof


def select_profile_interactive(profiles: list[str], default_key: str) -> str:
    current_idx = next((i for i, p in enumerate(profiles) if p == default_key), 0)
    num_opts = len(profiles)
    last_lines = 0

    try:
        tty_in = open("/dev/tty", "r")
        tty_fd = tty_in.fileno()
    except Exception:
        tty_in = None
        tty_fd = sys.stdin.fileno() if sys.stdin.isatty() else None

    def _get_k() -> str | None:
        if tty_fd is not None:
            try:
                old = termios.tcgetattr(tty_fd)
                try:
                    tty.setraw(tty_fd)
                    termios.tcflush(tty_fd, termios.TCIFLUSH)
                    b = os.read(tty_fd, 1)
                    if not b:
                        return None
                    if b == b"\x1b" and select.select([tty_fd], [], [], 0.05)[0]:
                        b += os.read(tty_fd, 2)
                    return b.decode("utf-8", errors="ignore")
                finally:
                    termios.tcsetattr(tty_fd, termios.TCSADRAIN, old)
            except Exception:
                return None
        return None

    try:
        sys.stderr.write("\033[?25l")
        while True:
            if last_lines > 0:
                sys.stderr.write(f"\033[{last_lines}A\r\033[J")

            lines_count = 2
            sys.stderr.write(
                "\n\033[1;36mSelect rs-agent Profile to Benchmark:\033[0m \033[2m(↑/↓ navigate, Enter run, Esc default, q abort)\033[0m\n"
            )

            for idx, p in enumerate(profiles):
                if "/" in p:
                    folder, stem = p.split("/", 1)
                    display_p = f"{folder} / {stem}"
                else:
                    display_p = p

                prefix = (
                    f"\033[1;36m  ❯ \033[1;37m{idx+1:2d}. \033[1;36m{display_p:<32}\033[0m\n"
                    if idx == current_idx
                    else f"\033[2m    {idx+1:2d}. {display_p:<32}\033[0m\n"
                )
                sys.stderr.write(prefix)
                lines_count += 1

            sys.stderr.write(f"\n\033[2m:: Enter: confirm [{profiles[current_idx]}]  Esc: default  q: abort\033[0m\n")
            lines_count += 2
            sys.stderr.flush()

            last_lines = lines_count
            key = _get_k()

            if key is None:
                break
            if key in ("\x1b[A", "k", "K"):
                current_idx = (current_idx - 1 + num_opts) % num_opts
            elif key in ("\x1b[B", "j", "J"):
                current_idx = (current_idx + 1) % num_opts
            elif key.isdigit() and 1 <= int(key) <= num_opts:
                current_idx = int(key) - 1
                break
            elif key in ("\r", "\n"):
                break
            elif key in ("\x03", "q", "Q"):
                sys.stderr.write(f"\033[{last_lines}A\r\033[J\nBenchmark aborted.\n")
                sys.exit(0)
            elif key == "\x1b":
                break

        sys.stderr.write(f"\033[{last_lines}A\r\033[J")
        sys.stderr.flush()
        return profiles[current_idx]
    finally:
        sys.stderr.write("\033[?25h")
        sys.stderr.flush()
        if tty_in:
            with contextlib.suppress(Exception):
                tty_in.close()


def get_current_model_info() -> tuple[str, str]:
    env_file = os.path.join(CFG_DIR, ".env")
    if os.path.isfile(env_file):
        with open(env_file, "r", encoding="utf-8") as f:
            lines = f.readlines()
        for i in range(1, 10):
            k_key = f"CUSTOM{i}_API_KEY"
            m_key = f"CUSTOM{i}_MODEL"
            u_key = f"CUSTOM{i}_URL"
            has_active_key = any(l.strip().startswith(k_key) for l in lines)
            if has_active_key:
                model = next((l.split("=")[1].strip().strip('"\'') for l in lines if l.strip().startswith(m_key)), f"custom-{i}")
                url = next((l.split("=")[1].strip().strip('"\'') for l in lines if l.strip().startswith(u_key)), "cloud")
                return model, url

    try:
        import urllib.request
        req = urllib.request.Request("http://127.0.0.1:8080/v1/models", headers={"User-Agent": "rs-agent-eval"})
        with urllib.request.urlopen(req, timeout=1.5) as resp:
            data = json.loads(resp.read().decode())
            if "data" in data and len(data["data"]) > 0:
                mid = data["data"][0].get("id", "").strip()
                if mid:
                    return mid, "http://127.0.0.1:8080"
    except Exception:
        pass

    return "local-model", "http://127.0.0.1:8080"


def _log_failure_trace(bench: dict, model_name: str, prof: str, output: str, ws: str):
    try:
        os.makedirs(EVALS_DIR, exist_ok=True)
        with open(FAILURES_LOG, "a", encoding="utf-8", errors="replace") as f:
            f.write(f"\n{'='*80}\n")
            f.write(f"FAILED TEST: {bench['id']} - {bench['name']}\n")
            f.write(f"MODEL: {model_name} | PROFILE: {prof}\n")
            f.write(f"TIMESTAMP: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
            f.write(f"{'='*80}\n\n")
            f.write("--- ENGINE STDOUT / REPL TRACE ---\n")
            f.write(RE_SECRET.sub("[REDACTED]", output) + "\n\n")
            f.write("--- WORKSPACE RESIDUAL FILES ---\n")
            for root, _, files in os.walk(ws):
                for file in files:
                    fp = os.path.join(root, file)
                    rel = os.path.relpath(fp, ws)
                    f.write(f"[{rel}]:\n{_safe_read(fp)[:1000]}\n\n")
    except Exception as e:
        sys.stderr.write(f"Warning: Failed to log failure trace: {e}\n")


def run_single_agentic_test(bench: dict, prof_name: str, is_purebash: bool, model_name: str) -> tuple[bool, float, int, int, str]:
    bare_name = re.sub(r"[^a-zA-Z0-9_\-]", "_", prof_name)
    sandbox_parent = os.path.join(tempfile.gettempdir(), "rs_evals")
    os.makedirs(sandbox_parent, exist_ok=True)
    sandbox_dir = tempfile.mkdtemp(prefix=f"{bare_name}_", dir=sandbox_parent)

    t0 = time.time()
    captured_stdout = ""
    turns = 0
    total_tokens = 0

    try:
        rs_meta = os.path.join(sandbox_dir, ".rs")
        os.makedirs(rs_meta, exist_ok=True)
        with open(os.path.join(rs_meta, "config.json"), "w", encoding="utf-8") as f:
            json.dump({
                "profile_name": prof_name,
                "tier": "PureBash" if is_purebash else "Smol",
                "is_agent": True,
                "adapters": True
            }, f, indent=2)

        if "setup_fn" in bench:
            bench["setup_fn"](sandbox_dir)

        proc = subprocess.Popen(
            [AI_BIN, "init", sandbox_dir],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            cwd=sandbox_dir,
        )

        clean_prompt = " ".join(bench["prompt"].split())
        task_payload = f"/task {clean_prompt}\nexit\n"
        try:
            captured_stdout, _ = proc.communicate(input=task_payload, timeout=180)
        except subprocess.TimeoutExpired:
            proc.kill()
            captured_stdout, _ = proc.communicate()
        except KeyboardInterrupt:
            proc.kill()
            with contextlib.suppress(Exception):
                proc.communicate(timeout=1)
            raise

        elapsed = time.time() - t0

        step_matches = re.findall(r"─── Step (\d+)/\d+ ───", captured_stdout)
        turns = len(step_matches) if step_matches else (1 if "Task complete" in captured_stdout else 0)

        pct_matches = re.findall(r"([\d\.]+)%/([\d\.]+)k", captured_stdout)
        if pct_matches:
            with contextlib.suppress(Exception):
                pct, cap_k = pct_matches[-1]
                total_tokens = int((float(pct) / 100.0) * (float(cap_k) * 1000))
        else:
            tok_matches = re.findall(r"↑([\d\.]+)k", captured_stdout)
            if tok_matches:
                with contextlib.suppress(Exception):
                    total_tokens = int(float(tok_matches[-1]) * 1000)

        passed = False
        try:
            passed = bool(bench["verify_fn"](sandbox_dir, captured_stdout))
        except Exception:
            passed = False

        if not passed:
            _log_failure_trace(bench, model_name, prof_name, captured_stdout, sandbox_dir)

        par_val = bench.get("par_turns", 1)
        detail = f"{elapsed:.2f}s ({turns}/{par_val}t)" if passed else "State verification failed"

        RUN_TRACES.append({
            "id": bench["id"],
            "name": bench["name"],
            "passed": passed,
            "elapsed_seconds": round(elapsed, 2),
            "turns": turns,
            "par_turns": par_val,
            "tokens": total_tokens,
            "trace": sanitize_terminal_output(captured_stdout),
        })

        return passed, elapsed, turns, total_tokens, detail
    finally:
        shutil.rmtree(sandbox_dir, ignore_errors=True)


def main():
    if not os.path.isfile(AI_BIN):
        sys.stderr.write(f"Error: rs-agent binary not found at {AI_BIN}. Run 'cargo build --release' first.\n")
        sys.exit(1)

    profiles = list_available_profiles()
    if not profiles:
        sys.stderr.write("Error: No profiles found in ~/.config/rs-agent/profiles/\n")
        sys.exit(1)

    model_name, endpoint = get_current_model_info()
    default_p = detect_default_profile(model_name, profiles)

    chosen_prof = None
    if len(sys.argv) > 1 and not sys.argv[1].startswith("-"):
        cli_arg = sys.argv[1]
        resolved = resolve_cli_profile(cli_arg, profiles)
        if resolved:
            chosen_prof = resolved
        else:
            sys.stderr.write(f"Warning: Profile '{cli_arg}' not found. Opening selection menu...\n")

    if not chosen_prof:
        chosen_prof = select_profile_interactive(profiles, default_key=default_p)

    prof_file = os.path.join(CFG_DIR, "profiles", f"{chosen_prof}.md")
    is_purebash = False
    has_delegate = False
    if os.path.isfile(prof_file):
        content = _safe_read(prof_file)
        is_purebash = "purebash: true" in content.lower()
        has_delegate = "delegate: true" in content.lower()

    mode_label = "Pure Bash (1-Tool Shell)" if is_purebash else ("Native 7-Tool (Delegate)" if has_delegate else "Native 6-Tool")

    fm = parse_profile_frontmatter(chosen_prof)
    budget_str = f"{fm['reasoning_budget']} tokens" if fm.get("reasoning_budget") else "unclamped"
    adapters_str = "enabled" if fm.get("adapters", True) else "disabled"

    if HAS_RICH:
        console.print(
            Panel(
                "[bold cyan]Rs-Agent Full-Stack Agentic & Tool-Calling Benchmark Suite[/bold cyan]\n"
                "[dim]Decision-grade evaluation: Par efficiency, token economy, tool resilience, and execution speed[/dim]",
                border_style="cyan", expand=False,
            )
        )
        console.print(f"Target Model:   [bold]{model_name}[/bold]")
        console.print(f"Harness Profile: [cyan]{chosen_prof}[/cyan] ({mode_label})")
        console.print(f"Governors:      [dim]Reasoning Budget: [bold yellow]{budget_str}[/bold yellow] · Adapters: [bold green]{adapters_str}[/bold green][/dim]\n")
    else:
        print(f"\n  rs-agent Benchmark Suite: {model_name} | {chosen_prof} ({mode_label})")
        print(f"  Governors: Reasoning Budget: {budget_str} · Adapters: {adapters_str}\n")

    if os.path.isfile(FAILURES_LOG):
        with contextlib.suppress(OSError):
            os.remove(FAILURES_LOG)

    active_benches = PUREBASH_BENCHMARKS if is_purebash else AGENTIC_BENCHMARKS
    results = []
    passed_count = 0
    total_time = 0.0
    total_tokens = 0
    total_actual_turns = 0
    total_par_turns = 0
    evaluated_count = 0
    task_scores = []
    spinner = MinimalSpinner()

    try:
        for idx, bench in enumerate(active_benches, start=1):
            evaluated_count += 1
            par = bench.get("par_turns", 1)
            total_par_turns += par

            spinner.start(f"[{idx}/{len(active_benches)}] Running {bench['id']} ({bench['name']})...")
            passed, elapsed, turns, toks, detail = run_single_agentic_test(bench, chosen_prof, is_purebash, model_name)
            spinner.stop()

            total_time += elapsed
            total_tokens += toks
            total_actual_turns += turns

            if passed:
                passed_count += 1
                status_str = "[bold green]PASS[/bold green]" if HAS_RICH else "PASS"
                turn_ratio = min(1.0, par / turns) if turns > 0 else 1.0
                task_scores.append(60.0 + (40.0 * turn_ratio))
            else:
                status_str = "[bold red]FAIL[/bold red]" if HAS_RICH else "FAIL"
                task_scores.append(0.0)

            tps = (toks / elapsed) if elapsed > 0 else 0
            turn_metrics = f"{turns}t (Par {par})" if passed else "FAILED"
            results.append((
                bench["id"],
                bench["name"],
                bench["tools_tested"],
                status_str,
                turn_metrics,
                f"{toks:,}t" if toks else "-",
                f"{tps:.1f} t/s" if tps else "-",
            ))

            prefix_icon = "[green]OK[/green]" if passed else "[red]XX[/red]"
            if HAS_RICH:
                console.print(
                    f"  {prefix_icon} {status_str} : [bold]{bench['id']}[/bold] {bench['name']:<33} {detail:<20} @ [cyan]{tps:.1f} t/s[/cyan]"
                )
            else:
                print(f"  {status_str} : {bench['id']} {bench['name']:<33} {detail}")
    except KeyboardInterrupt:
        spinner.stop()
        if HAS_RICH:
            console.print("\n[bold yellow]Benchmark aborted by user (Ctrl+C).[/bold yellow]\n")
        else:
            print("\nBenchmark aborted by user (Ctrl+C).\n")
        sys.exit(130)
    finally:
        spinner.stop()

    accuracy = (passed_count / evaluated_count * 100) if evaluated_count > 0 else 0
    par_eff = (total_par_turns / total_actual_turns * 100) if total_actual_turns > 0 else 0
    avg_tps = (total_tokens / total_time) if total_time > 0 else 0
    toks_per_turn = (total_tokens / total_actual_turns) if total_actual_turns > 0 else 0

    agent_index = (sum(task_scores) / len(task_scores)) if task_scores else 0.0
    grade = "A+" if agent_index >= 95 else "A" if agent_index >= 88 else "B" if agent_index >= 75 else "C" if agent_index >= 60 else "F"

    if HAS_RICH:
        table = Table(title=f"\nAgentic Stack Benchmark: {model_name} [{chosen_prof}]", border_style="bright_black")
        table.add_column("ID", style="cyan", justify="left")
        table.add_column("Agent Challenge", style="white")
        table.add_column("Tools Exercised", style="dim")
        table.add_column("Result", justify="center")
        table.add_column("Turns / Par", justify="center")
        table.add_column("Context", justify="right")
        table.add_column("Speed", style="green", justify="right")

        for row in results:
            table.add_row(*row)
        console.print(table)

        summary = Text()
        summary.append(f"Pass Rate:        {passed_count}/{evaluated_count} ({accuracy:.1f}%)\n", style="bold green" if accuracy >= 80 else "bold red")
        summary.append(f"Par Efficiency:   {par_eff:.1f}% ({total_actual_turns} actual turns / {total_par_turns} par target)\n", style="cyan")
        summary.append(f"Token Economy:    {total_tokens:,} total tokens (~{toks_per_turn:.0f} tokens/turn)\n", style="dim")
        summary.append(f"Effective Speed:  {avg_tps:.1f} tokens/second (Total elapsed: {total_time:.2f}s)\n", style="dim")
        summary.append(f"\nAgent Performance Index: {agent_index:.1f}/100 [Grade: {grade}]", style="bold yellow")
        console.print(Panel(summary, title="Conclusive Benchmark Evaluation", border_style="green" if accuracy == 100 else "yellow", box=ROUNDED, expand=False))
    else:
        print(f"\n{'='*60}\nPass Rate:        {passed_count}/{evaluated_count} ({accuracy:.1f}%)\nPar Efficiency:   {par_eff:.1f}%\nAgent Index:      {agent_index:.1f}/100 [Grade: {grade}]\n{'='*60}\n")

    try:
        os.makedirs(EVALS_DIR, exist_ok=True)
        safe_model = re.sub(r"[^a-zA-Z0-9_\-]", "_", model_name).strip("_")
        safe_prof = re.sub(r"[^a-zA-Z0-9_\-]", "_", chosen_prof).strip("_")
        ts_str = time.strftime("%Y%m%d_%H%M%S")
        trace_file = os.path.join(EVALS_DIR, f"eval_trace_{safe_model}_{safe_prof}_{ts_str}.json")

        run_payload = {
            "timestamp": int(time.time()),
            "model": model_name,
            "profile": chosen_prof,
            "governors": {
                "reasoning_budget": fm.get("reasoning_budget"),
                "adapters": fm.get("adapters", True),
            },
            "mode": mode_label,
            "accuracy": round(accuracy, 1),
            "par_efficiency": round(par_eff, 1),
            "total_tokens": total_tokens,
            "tokens_per_turn": round(toks_per_turn, 1),
            "avg_tps": round(avg_tps, 1),
            "total_time": round(total_time, 2),
            "agent_index": round(agent_index, 1),
            "grade": grade,
            "traces": RUN_TRACES,
        }

        with open(trace_file, "w", encoding="utf-8") as wf:
            json.dump(run_payload, wf, indent=2)

        if HAS_RICH:
            console.print(f"[dim]Run trace saved: [cyan]{trace_file}[/cyan][/dim]")
            if passed_count < evaluated_count and os.path.isfile(FAILURES_LOG):
                console.print(f"[bold red]Failure log saved:[/bold red] [yellow]{FAILURES_LOG}[/yellow]\n")
            else:
                console.print()
        else:
            print(f"Run trace saved: {trace_file}")
            if passed_count < evaluated_count and os.path.isfile(FAILURES_LOG):
                print(f"Failure log saved: {FAILURES_LOG}\n")
    except Exception as e:
        sys.stderr.write(f"Warning: Failed to save trace log: {e}\n")


if __name__ == "__main__":
    main()
