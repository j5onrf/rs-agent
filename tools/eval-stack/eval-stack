RE_SECRET = re.compile(
    r"(?:sk-[a-zA-Z0-9_\-]{8}|ghp_[a-zA-Z0-9]{8}|AIzaSy[a-zA-Z0-9_\-]{8}|Bearer\s+[a-zA-Z0-9_\-\.]{8})[a-zA-Z0-9_\-\.]*",
    re.IGNORECASE,
)
RE_ANSI = re.compile(r"\x1b\[[0-9;?]*[a-zA-Z]|\x1b\([B0]")


def sanitize_terminal_output(raw: str) -> list[str]:
    """Strips ANSI sequences, cursor codes, transient spinner lines, and pre-task setup banners."""
    clean = RE_ANSI.sub("", raw)
    clean = clean.replace("\r\n", "\n").replace("\r", "\n")

    # Slice strictly from the task loop start to discard pre-task UI animations entirely
    idx = clean.find("[Task Loop]")
    if idx != -1:
        clean = clean[idx:]

    filtered = []
    for line in clean.splitlines():
        s = line.strip()
        if not s:
            continue
        if any(token in s for token in (
            "Executing autonomous step...", "Prefilling...", "Preloading...",
            "Working...", "Drafting tool action...", "Evaluating tool results..."
        )):
            continue
        if re.match(r"^[·\s○●•]+$", s):
            continue
        filtered.append(s)
    return filtered


class MinimalSpinner:
    def __init__(self):
        self.label = "Working..."
        self.stop_event = threading.Event()
        self.thread = None
        self.chars = ["-", "\\", "|", "/"]
        self._lock = threading.RLock()

    def start(self, label: str = "Working..."):
        with self._lock:
            self.stop()
            self.label = label
            self.stop_event = threading.Event()
            self.start_time = time.time()
            self.thread = threading.Thread(target=self._spin, daemon=True)
            self.thread.start()

    def _spin(self):
        if sys.stderr.isatty():
            sys.stderr.write("\033[?25l")
            sys.stderr.flush()

        while not self.stop_event.is_set():
            if sys.stderr.isatty():
                elapsed = time.time() - self.start_time
                sys.stderr.write(
                    f"\r\x1b[2K  \033[2m{self.label}\033[0m \033[1;36m{elapsed:.1f}s\033[0m"
                )
                sys.stderr.flush()
            if self.stop_event.wait(0.25):
                break

    def stop(self):
        with self._lock:
            self.stop_event.set()
            t, self.thread = self.thread, None
            if t and t.is_alive():
                t.join(timeout=1.0)
            if sys.stderr.isatty():
                sys.stderr.write("\r\033[2K\r\033[?25h")
                sys.stderr.flush()


def _safe_read(path: str) -> str:
    if os.path.isfile(path):
        try:
            with open(path, "r", encoding="utf-8", errors="ignore") as f:
                return f.read()
        except OSError:
            pass
    return ""


def _write_fixture(ws: str, fname: str, content: str) -> None:
    target = os.path.join(ws, fname)
    os.makedirs(os.path.dirname(target), exist_ok=True)
    with open(target, "w", encoding="utf-8") as f:
        f.write(content)


def _verify_python_script(script_path: str, cwd: str, timeout: int = 15) -> bool:
    safe_env = {
        "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
        "HOME": cwd,
        "PYTHONPATH": cwd,
    }
    try:
        res = subprocess.run(
            [sys.executable, script_path],
            cwd=cwd,
            capture_output=True,
            text=True,
            timeout=timeout,
            stdin=subprocess.DEVNULL,
            env=safe_env,
        )
        return res.returncode == 0
    except (subprocess.TimeoutExpired, OSError):
        return False


